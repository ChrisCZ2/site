---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  readTime?: number;
}

const { title, description, pubDate, tags, readTime } = Astro.props;
const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pageTitle = `${title} — ${site.name}`;
---

<BaseLayout title={pageTitle} description={description} layout="post">
  <header class="intro">
    <div class="inner">
      <div class="intro-text">
        <h1 id="page-title" class="intro-title">{title}</h1>
        {description && <p class="intro-subtitle">{description}</p>}

        <p class="entry-meta">
          <span class="byline-item">
            <Icon name="calendar" />
            <time datetime={pubDate.toISOString()}>{formatted}</time>
          </span>
          {readTime && (
            <span class="byline-item">
              <Icon name="stopwatch" />
              {readTime} min read
            </span>
          )}
        </p>

        {tags.length > 0 && (
          <p class="entry-tags">
            {tags.map((tag) => (
              <span class="skill-chip">#{tag}</span>
            ))}
          </p>
        )}
      </div>
    </div>
  </header>

  <main id="main" class="page-content" aria-label="Content">
    <div class="inner">
      <article class="entry-content prose-writeup">
        <slot />
      </article>
    </div>
  </main>
</BaseLayout>
