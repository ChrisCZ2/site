---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  crumb?: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} — ${site.name}`;
---

<BaseLayout title={pageTitle} description={description} layout="page">
  <header class="intro">
    <div class="inner">
      <div class="intro-text">
        <h1 id="page-title" class="intro-title">{title}</h1>
        {description && <p class="intro-subtitle">{description}</p>}
      </div>
    </div>
  </header>

  <main id="main" class="page-content" aria-label="Content">
    <div class="inner">
      <slot />
    </div>
  </main>
</BaseLayout>
