---
import BaseLayout from './BaseLayout.astro';
import SeverityBadge from '../components/SeverityBadge.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  severity: 'critical' | 'high' | 'medium' | 'low' | 'info';
  program?: string;
  tags: string[];
}

const { title, description, pubDate, severity, program, tags } = Astro.props;
const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pageTitle = `${title} — ${site.name}`;
---

<BaseLayout title={pageTitle} description={description}>
  <header class="page-head">
    <div class="crumbs">root@{site.handle}:~# cat writeups/{title.toLowerCase().replace(/\s+/g, '-')}.md</div>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 12px">
      <SeverityBadge severity={severity} />
      {program && <span style="font-family: var(--font-mono); font-size: 13px; color: var(--steel)">{program}</span>}
    </div>
    <h1>{title}</h1>
    <p>{description}</p>
    <p style="font-family: var(--font-mono); font-size: 12px; color: var(--steel); margin-top: 12px">
      <time datetime={pubDate.toISOString()}>{formatted}</time>
      {
        tags.length > 0 && (
          <>
            {' · '}
            {tags.map((tag) => (
              <span style="color: var(--highlight)">#{tag} </span>
            ))}
          </>
        )
      }
    </p>
  </header>
  <article class="card prose-writeup">
    <slot />
  </article>
</BaseLayout>
