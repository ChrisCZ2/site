---
import PageLayout from '../layouts/PageLayout.astro';
import TopicArchive from '../components/TopicArchive.astro';
import { topicBySlug } from '../config/topics';
import { getCollection } from 'astro:content';

const topic = topicBySlug.blog;
const writeups = (await getCollection('writeups'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout title={topic.title} description={topic.description} crumb="$ ls ./blog/">
  <TopicArchive topic={topic} writeups={writeups} />
</PageLayout>
