---
import PageLayout from '../layouts/PageLayout.astro';
import TopicArchive from '../components/TopicArchive.astro';
import { topicBySlug } from '../config/topics';
import { getCollection } from 'astro:content';

const topic = topicBySlug.ctfs;
const writeups = (await getCollection('writeups'))
  .filter((w) => !w.data.draft && w.data.category === topic.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout title={topic.title} description={topic.description} crumb="$ ls ./ctfs/">
  <p class="topic-intro">CTF challenge writeups and walkthroughs from events like NahamCon.</p>
  <TopicArchive topic={topic} writeups={writeups} />
</PageLayout>
