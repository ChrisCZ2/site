---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryHero from '../components/StoryHero.astro';
---

<BaseLayout fullWidth>
  <StoryHero />
</BaseLayout>

<style is:global>
  /* Homepage is a single full-screen hero — hide global header/footer here only */
  .site-header,
  .site-footer {
    display: none;
  }

  body {
    background: #0a0a0a;
  }

  .shell {
    display: flex;
    flex-direction: column;
  }
</style>
