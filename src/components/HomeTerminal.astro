---
import { site } from '../config/site';
import { media } from '../config/media';
---

<div class="home-terminal-prompt">
  <span class="user">root@{site.handle}</span>:~#   <span class="cm">./exploit.sh</span>
</div>
<div class="home-terminal-wrap">
  <div class="home-terminal home-terminal--gif">
    <img
      src={media.homeTerminalGif}
      alt="Animated terminal: BugHunter exploit script with SQLi, IDOR, BOLA, SSRF, XSS writeups"
      loading="lazy"
      width="800"
      height="340"
    />
  </div>
  <pre class="home-terminal-fallback" aria-hidden="true"><code>{`import Target from 'reality'
const hunter = new BugHunter({
  handle: '${site.handle}',
  skill: 'appsec',
  writeups: ${site.stats.reports},
  disclosure: 'responsible'
});
// SQLi · IDOR · BOLA · SSRF · XSS
await hunter.pwn(['...in-scope']);
console.log('Writeups live on chriscz.com');`}</code></pre>
</div>
