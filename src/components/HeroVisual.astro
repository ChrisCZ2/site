---
import { site } from '../config/site';
import { media } from '../config/media';
---

<div class="hero-visual reveal">
  <div class="hero-visual-glow" aria-hidden="true"></div>
  <div class="hero-visual-frame">
    <img class="hero-visual-bg" src={media.heroPoster} alt="" loading="eager" />
    <img
      class="hero-visual-gif hero-visual-gif--root"
      src={media.chrisczRoot}
      alt=""
      aria-hidden="true"
      loading="eager"
      title="chriscz"
    />
    <span class="live-pill"><span class="live-dot"></span> root@{site.handle}</span>
    <span class="hero-visual-stat">{site.stats.reports} writeups live</span>
  </div>
</div>
