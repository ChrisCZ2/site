---
/**
 * chriscz brand mark — a hexagon (security motif) holding the "cz" monogram.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  role="img"
  aria-label="chriscz logo"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff2d88" />
      <stop offset="1" stop-color="#ff6aae" />
    </linearGradient>
  </defs>
  <polygon
    points="20,1.5 36,10.75 36,29.25 20,38.5 4,29.25 4,10.75"
    fill={`url(#${id})`}
  />
  <text
    x="20"
    y="20"
    text-anchor="middle"
    dominant-baseline="central"
    fill="#0e0e0e"
    font-family="'Poppins','Inter',sans-serif"
    font-size="16"
    font-weight="800"
    letter-spacing="-0.5"
  >cz</text>
</svg>
