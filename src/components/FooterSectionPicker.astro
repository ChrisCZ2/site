---
import { siteSections } from '../config/sections';
---

<div class="footer-section-picker">
  <p class="footer-section-picker-label">Sections</p>
  <div class="footer-section-picker-grid">
    {
      siteSections.map((section) => (
        <a href={section.href} class="footer-section-picker-card">
          <img src={section.gif} alt="" width="48" height="48" loading="lazy" />
          <span>{section.title}</span>
        </a>
      ))
    }
  </div>
</div>
