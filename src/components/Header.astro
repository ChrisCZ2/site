---
import { site } from '../config/site';
import { mainNav, headerCta } from '../config/navigation';
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const segment = pathname.replace(/^\/+|\/+$/g, '');
const lsTarget = segment ? `./${segment}` : './';
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand">
      <Logo size={34} class="brand-logo" />
      <span class="brand-name">{site.handle}</span>
      <span class="brand-sep">//</span>
      <span class="brand-role">bug_hunter</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {mainNav.map(({ href, label }) => (
        <a href={href} class:list={[isActive(href) && 'active']}>
          {label}
        </a>
      ))}
    </nav>

    <span class="header-prompt">
      <span class="header-prompt-user">{site.handle}@web</span><span class="header-prompt-sep">:~$</span>
      <span class="header-prompt-cmd">ls {lsTarget}</span>
    </span>

    <div class="header-cta">
      {headerCta.map((link, i) =>
        i === headerCta.length - 1 ? (
          <a href={link.href} class="btn-primary">{link.label} →</a>
        ) : (
          <a href={link.href} class="btn-ghost">{link.label}</a>
        )
      )}
    </div>
  </div>
</header>
