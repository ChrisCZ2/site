---
import { site } from '../config/site';

const isHome = Astro.url.pathname === '/';
const Tag = isHome ? 'h1' : 'p';
---

<header id="masthead">
  <div class="inner">
    <div class="title-area">
      <Tag class="site-title">
        <a href="/" aria-label={site.name}>
          <img src={site.logo} alt={site.name} class="site-logo" />
        </a>
      </Tag>
    </div>
  </div>
</header>
