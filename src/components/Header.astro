---
import { site } from '../config/site';
import { mainNav, headerCta } from '../config/navigation';

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const mark = site.handle.slice(0, 2).toUpperCase();
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand">
      <span class="brand-mark">{mark}</span>
      <span class="brand-name">{site.handle}</span>
      <span class="brand-sep">//</span>
      <span class="brand-role">bug_hunter</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {mainNav.map(({ href, label }) => (
        <a href={href} class:list={[isActive(href) && 'active']}>
          {label}
        </a>
      ))}
    </nav>

    <span class="header-status">&gt;_ STATUS: ACTIVE &gt;_</span>

    <div class="header-cta">
      {headerCta.map((link, i) =>
        i === headerCta.length - 1 ? (
          <a href={link.href} class="btn-primary">{link.label} →</a>
        ) : (
          <a href={link.href} class="btn-ghost">{link.label}</a>
        )
      )}
    </div>
  </div>
</header>
